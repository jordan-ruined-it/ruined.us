/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Font and images rarely change: browsers may keep them for a day.
/assets/studio.jpg
  Cache-Control: public, max-age=86400
/assets/icon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# CSS and JS change together: always re-check, so a visitor never mixes old and new.
/assets/style.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/site.js
  Cache-Control: public, max-age=0, must-revalidate

# Downloads are versioned in the filename (ruined-player-1.0.zip), so they can be cached hard.
/assets/downloads/*
  Cache-Control: public, max-age=31536000, immutable
